<% content_for :title, "HexaAlerts — O Mundial fica na história" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<main class="portfolio-shell min-h-screen text-slate-100" data-controller="live-matches-modal">
  <%= turbo_stream_from "competition_updates" %>
  <header class="border-b border-white/10 px-5 py-5 sm:px-8">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4">
      <%= link_to root_path, class: "flex items-center gap-3", aria: { label: "HexaAlerts, início" } do %>
        <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-emerald-400/30 bg-emerald-400/10 font-black text-emerald-400">H<span class="text-[10px]">6</span></span>
        <div><h1 class="text-xl font-extrabold tracking-tight">HexaAlerts<span class="text-emerald-400">.</span></h1><p class="mt-0.5 text-[10px] uppercase tracking-[0.2em] text-slate-500">Futebol em cada detalhe</p></div>
      <% end %>
      <nav class="hidden items-center gap-7 text-sm text-slate-400 md:flex" aria-label="Navegação principal">
        <a href="#rankings" class="hover:text-white">Rankings</a><a href="#partidas" class="hover:text-white">Partidas</a><a href="#alertas" class="hover:text-white">Alertas</a>
      </nav>
      <%= button_to competition_syncs_path, params: { fan_id: @fan&.id }, disabled: @sync&.active?, class: "inline-flex cursor-pointer items-center gap-2 rounded-lg bg-emerald-400 px-4 py-2.5 text-xs font-bold text-slate-950 transition hover:bg-emerald-300 disabled:cursor-wait disabled:opacity-60 sm:text-sm", data: { testid: "refresh-competition", turbo_submits_with: "Iniciando…" } do %>
        <svg class="h-4 w-4 <%= 'animate-spin' if @sync&.active? %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.1 8a7 7 0 0 1 11.6-2L20 9M4 15l2.3 3A7 7 0 0 0 17.9 16"/></svg>
        <%= @sync&.active? ? "Atualizando…" : "Atualizar aplicação" %>
      <% end %>
    </div>
  </header>
  <div class="mx-auto max-w-6xl"><%= render "sync_status" %></div>
  <% if flash.any? %>
    <div class="mx-auto max-w-6xl px-5 pt-5 sm:px-8" role="status">
      <% flash.each do |_type, message| %><p class="rounded-xl border border-emerald-400/20 bg-emerald-400/5 px-4 py-3 text-sm text-emerald-200"><%= message %></p><% end %>
    </div>
  <% end %>

  <div class="mx-auto max-w-6xl space-y-12 px-5 py-8 sm:px-8 sm:py-10">
    <section class="tournament-hero relative overflow-hidden rounded-3xl border border-white/10" aria-labelledby="tournament-title">
      <div class="relative z-10 grid gap-6 p-6 sm:p-10 md:grid-cols-[1fr_16rem] md:gap-10">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow text-slate-400">CANADÁ · MÉXICO · ESTADOS UNIDOS</p>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300/20 bg-amber-300/10 px-2.5 py-1 text-[10px] font-bold text-amber-200" data-testid="competition-status"><span class="h-1 w-1 rounded-full bg-amber-300"></span><%= @summary.finished? ? "COMPETIÇÃO ENCERRADA" : "COPA DO MUNDO 2026" %></span>
          </div>
          <h2 id="tournament-title" class="mt-6 max-w-xl text-4xl leading-[1.1] font-extrabold tracking-tight sm:text-5xl">O apito final soou.<br><span class="text-slate-400">A história continua aqui.</span></h2>
          <p class="mt-5 max-w-lg text-sm leading-7 text-slate-400">Reviva a Copa do Mundo 2026. Os resultados, as seleções que foram mais longe e os jogadores que fizeram a diferença, em um só lugar.</p>
          <div class="mt-7 flex flex-wrap items-center gap-5 text-xs">
            <span class="text-slate-300">11 de junho <span class="px-1 text-slate-600">—</span> 19 de julho de 2026</span>
            <a href="#partidas" class="font-semibold text-emerald-400 hover:text-emerald-300">Explorar resultados <span class="ml-1">↗</span></a>
          </div>
        </div>
        <div class="trophy-orbit hidden flex-col items-center justify-center rounded-2xl border border-amber-200/10 px-5 py-3 md:flex">
          <div class="h-40 w-36 text-amber-300"><%= render "trophy" %></div>
          <p class="eyebrow mt-1 text-amber-200/60">CAMPEÃ DO MUNDO</p>
          <p class="mt-2 text-xl font-bold"><span aria-hidden="true">🇪🇸</span> Espanha</p>
          <p class="mt-1 text-xs text-slate-500">Uma campanha para a história.</p>
        </div>
      </div>
      <dl class="grid grid-cols-2 divide-x divide-white/10 border-t border-white/10 bg-black/10 sm:grid-cols-4">
        <% [["48", "SELEÇÕES"], [@match_count, "PARTIDAS NO ACERVO"], [@goal_count, "GOLS REGISTRADOS"], [@finished_match_count, "JOGOS ENCERRADOS"]].each do |value, label| %>
          <div class="px-5 py-5 sm:px-8"><dd class="font-mono text-2xl font-semibold"><%= value %><span class="ml-1 text-emerald-400">.</span></dd><dt class="mt-1.5 text-[9px] font-semibold tracking-[0.12em] text-slate-500 sm:text-[10px]"><%= label %></dt></div>
        <% end %>
      </dl>
    </section>

    <%= render "rankings" if @summary.finished? %>

    <section id="partidas" class="scroll-mt-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div><p class="eyebrow text-emerald-400">CADA JOGO, UMA HISTÓRIA</p><h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Resultados da Copa</h2></div>
        <div class="flex rounded-lg border border-white/10 bg-slate-900/50 p-1 text-xs" aria-label="Filtrar partidas">
          <% [["knockout", "Mata-mata"], ["group", "Grupos"], ["all", "Todos"]].each do |stage, label| %>
            <%= link_to label, root_path(stage:, fan_id: @fan&.id, anchor: "partidas"), class: "rounded-md px-3 py-2 font-semibold #{@stage == stage || (@stage.blank? && stage == 'all') ? 'bg-white/10 text-white' : 'text-slate-500 hover:text-white'}", aria: { current: (@stage == stage ? "page" : nil) } %>
          <% end %>
        </div>
      </div>
      <% if @live_matches.any? %>
        <button type="button" data-action="live-matches-modal#open" aria-haspopup="dialog" class="mb-5 rounded-full bg-emerald-400 px-4 py-2 text-sm font-bold text-slate-950"><%= pluralize(@live_matches.size, "jogo ao vivo", "jogos ao vivo") %></button>
        <%= render "live_matches_modal", matches: @live_matches %>
      <% end %>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-testid="matches-list">
        <%= render partial: "matches/card", collection: @matches, as: :match %>
      </div>
      <% if @matches.empty? %>
        <div class="rounded-2xl border border-dashed border-white/10 p-8 text-center"><p class="text-slate-400">Nenhuma partida nesta fase ainda.</p><p class="mt-2 text-sm text-slate-500">Use “Atualizar aplicação” para carregar os resultados de todo o torneio.</p></div>
      <% end %>
    </section>

    <section id="alertas" class="grid scroll-mt-6 gap-8 border-t border-white/10 pt-10 lg:grid-cols-[1fr_22rem]">
      <div>
        <p class="eyebrow text-emerald-400">DO PRIMEIRO LANCE AO APITO FINAL</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight">Seus alertas</h2>
        <p class="mt-3 max-w-lg text-sm leading-6 text-slate-500">O torneio terminou. Consulte os lances registrados para as seleções e partidas que você acompanha.</p>
        <% if @fans.any? %>
          <%= form_with url: root_path, method: :get, class: "mt-5 flex items-center gap-3" do |form| %>
            <%= form.label :fan_id, "Torcedor", class: "text-xs text-slate-500" %>
            <%= form.select :fan_id, options_from_collection_for_select(@fans, :id, :name, @fan&.id), {}, onchange: "this.form.requestSubmit()", class: "rounded-lg border border-white/10 bg-slate-900 px-3 py-2 text-sm" %>
          <% end %>
        <% end %>
        <%= turbo_stream_from "fan_#{@fan.id}_alerts" if @fan %>
        <div id="alerts" class="mt-5 space-y-3">
          <%= render partial: "match_events/alert", collection: @events, as: :match_event %>
          <% if @events.empty? %><div id="alerts-empty" class="rounded-2xl border border-dashed border-white/10 p-8 text-center text-sm text-slate-500">Nenhum lance registrado para suas assinaturas.</div><% end %>
        </div>
      </div>
      <aside class="space-y-5" aria-label="Preferências de alertas">
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
          <h2 class="font-bold">Suas seleções, seus alertas.</h2>
          <% if @fan %>
            <%= form_with model: AlertSubscription.new, class: "mt-4 space-y-3" do |form| %>
              <%= form.hidden_field :fan_id, value: @fan.id %>
              <%= form.select :team_id, @teams.map { |team| [team_display_name(team), team.id] }, { include_blank: "Seleção (opcional)" }, aria: { label: "Seleção para acompanhar" }, class: "w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2 text-sm" %>
              <%= form.select :match_id, @all_matches.map { |match| ["#{match.home_team.fifa_code} × #{match.away_team.fifa_code}", match.id] }, { include_blank: "Jogo (opcional)" }, aria: { label: "Partida para acompanhar" }, class: "w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2 text-sm" %>
              <%= form.select :event_kind, MatchEvent::KINDS.map { |kind| [event_kind_label(kind), kind] }, { include_blank: "Qualquer evento" }, aria: { label: "Tipo de evento" }, class: "w-full rounded-lg border border-white/10 bg-slate-900 px-3 py-2 text-sm" %>
              <%= form.submit "Ativar alerta", class: "w-full cursor-pointer rounded-lg bg-emerald-400 px-4 py-2.5 text-sm font-bold text-slate-950 hover:bg-emerald-300" %>
            <% end %>
          <% else %><p class="mt-3 text-sm text-slate-400">Carregue os dados de demonstração para explorar os alertas.</p><% end %>
        </div>
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
          <h2 class="text-sm font-bold">Assinaturas ativas</h2>
          <div class="mt-3 space-y-2 text-sm">
            <% @subscriptions.each do |subscription| %>
              <div class="flex items-center justify-between gap-3 rounded-lg bg-white/5 p-3">
                <span class="text-xs text-slate-400"><%= subscription.team ? team_display_name(subscription.team) : "Jogo ##{subscription.match_id}" %> · <%= subscription.event_kind.present? ? event_kind_label(subscription.event_kind) : "todos" %></span>
                <%= button_to "×", alert_subscription_path(subscription), method: :delete, class: "cursor-pointer px-2 text-red-300", aria: { label: "Remover alerta" } %>
              </div>
            <% end %>
            <% if @subscriptions.empty? %><p class="text-xs text-slate-500">Você ainda não tem assinaturas.</p><% end %>
          </div>
        </div>
      </aside>
    </section>
    <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-white/10 py-6 text-xs text-slate-600">
      <span>HexaAlerts · Construído com Ruby on Rails, Hotwire e Sidekiq.</span><span>Projeto de portfólio · Copa do Mundo 2026</span>
    </footer>
  </div>
</main>
